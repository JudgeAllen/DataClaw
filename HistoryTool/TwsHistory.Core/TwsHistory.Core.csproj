<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>TwsHistory.Core</RootNamespace>
    <AssemblyName>TwsHistory.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The IB API (..\..\client) is compiled directly into this library instead of
    being referenced as a project: building CSharpAPI.csproj requires
    Google.Protobuf 3.29.5 from nuget.org, which is not reachable on this
    machine. Version 3.15.8 is already present in the local NuGet cache and
    satisfies the API's needs (see ProtobufCompatShim.cs).
  -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.15.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\client\*.cs" />
    <Compile Include="..\..\client\protobuf\*.cs" />
  </ItemGroup>

</Project>
