<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>TwsHistory</RootNamespace>
    <AssemblyName>TwsHistory</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sibling projects must not leak into this one via the default **/*.cs glob -->
    <Compile Remove="TwsHistory.Core\**;TwsHistoryGui\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="TwsHistory.Core\TwsHistory.Core.csproj" />
  </ItemGroup>

</Project>
